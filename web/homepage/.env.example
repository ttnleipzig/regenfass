# Filled by `node scripts/sync-swetrix-env.mjs` from the repo root `.env`
# (SWETRIX_PROJECT_ID_HOMEPAGE → VITE_SWETRIX_PROJECT_ID).
# Vite only exposes VITE_* vars to the browser.
VITE_SWETRIX_PROJECT_ID=

# Server-only Listmonk credentials for netlify/functions/newsletter-subscribe.ts.
LISTMONK_URL=https://news.regenfass.eu
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_NEWS_DE_LIST_ID=
LISTMONK_NEWS_EN_LIST_ID=
LISTMONK_BETA_DE_LIST_ID=
LISTMONK_BETA_EN_LIST_ID=
